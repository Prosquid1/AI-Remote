# ==========================
# Global ignores
# ==========================
# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root
*.swp
*.swo
*.tmp
*.log

# ==========================
# Android project (android/)
# ==========================
# Built application files
android/**/*.apk
android/**/*.ap_
android/**/*.aab

# Files for the ART/Dalvik VM
android/**/*.dex

# Java class files
android/**/*.class

# Generated files
android/bin/
android/gen/
android/out/

# Gradle files
android/.gradle/
android/build/
!android/gradle/wrapper/gradle-wrapper.jar

# Local configuration file (sdk path, etc)
android/local.properties

# Proguard folder generated by Eclipse
android/proguard/

# Crashlytics
android/crashlytics-build.properties

# External native build folder (NDK)
android/.externalNativeBuild
android/obj/
android/**/*.so

# Android Studio
android/.idea/
android/*.iml
android/*.iws
android/*.ipr

# Google Services (JSON file)
android/google-services.json

# ==========================
# macOS project (macOS/)
# ==========================
# Xcode build products
macOS/build/
macOS/DerivedData/
macOS/*.pbxuser
macOS/*.mode1v3
macOS/*.mode2v3
macOS/*.perspectivev3
macOS/*.xcworkspace

# Xcode generated files
macOS/*.xccheckout
macOS/*.xcuserstate

# Swift Package Manager
macOS/.build/
macOS/Package.resolved

# CocoaPods
macOS/Pods/
macOS/Podfile.lock

# Carthage
macOS/Carthage/Build/

# macOS specific files
macOS/*.DS_Store
